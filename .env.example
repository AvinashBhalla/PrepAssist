# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Authentication (use a long random value locally; never commit real secrets)
JWT_SECRET=replace-with-a-long-random-secret

# Persistence
MONGODB_URI=

# LLM provider selection: groq | gemini | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=

# Retrieval controls
RETRIEVAL_TIMEOUT_MS=10000
RETRIEVAL_MAX_BYTES=2000000
RETRIEVAL_MAX_PAGES=20
RETRIEVAL_MAX_DEPTH=2
RETRIEVAL_CONCURRENCY=2
