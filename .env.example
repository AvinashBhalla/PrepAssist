# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Authentication placeholder (authentication is not implemented in Phase 1A)
JWT_SECRET=replace-with-a-long-random-secret

# Persistence
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-prep-kit

# LLM provider selection: groq | gemini | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=

# Retrieval controls
RETRIEVAL_TIMEOUT_MS=10000
RETRIEVAL_MAX_BYTES=2000000
RETRIEVAL_MAX_PAGES=20
